# ============================================================
# CONFIGURAÇÃO DO SUPABASE + APP
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ----- Banco de dados (Supabase) -----
# Acesse: Supabase Dashboard → Project Settings → Database → Connection string
# Use a Connection String do tipo "URI" (Transaction Pooler para Vercel Serverless)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ----- Autenticação (e-mail + senha, própria) -----
# Gere um valor aleatório forte, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=seu_jwt_secret_aqui

# ----- E-mails autorizados -----
# Usuários que podem criar conta (registro) no app
ALLOWED_EMAIL_1=igorempresas2@gmail.com
ALLOWED_EMAIL_2=giovana.pedrette@estudante.ufjf.br

# ----- Configurações do Vite (frontend) -----
VITE_APP_ID=financas-app

# ----- Configurações de ambiente -----
NODE_ENV=development
PORT=3000
